# Modelo de configuração. Copie para .env e preencha; nunca versione o .env.
# Gere os segredos com:
#   openssl rand -base64 24   -> POSTGRES_PASSWORD
#   openssl rand -base64 48   -> SESSION_SECRET
#   openssl rand -hex 32      -> ENCRYPTION_KEY (perder esta chave invalida o 2FA)
# PUBLIC_ORIGIN é a URL pública exata do site; em dev sem HTTPS use COOKIE_SECURE=false.

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio
PUBLIC_ORIGIN=https://seudominio.com
SESSION_SECRET=
ENCRYPTION_KEY=
COOKIE_SECURE=true
TRUST_PROXY=true
WEB_PORT=8080
